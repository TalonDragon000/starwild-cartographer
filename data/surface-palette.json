  "ink": "#1a1712",
  "contour": "#4a2c16",
  "contourIndex": "#2c1a0e",
  "grid": "#1a1712",
  "gridMinor": "#3f3c34",
  "markerPlate": "#10201c",
  "markerRing": "#f4efe2",
  "fallback": {
    "id": "other",
    "label": "Other surface",
    "fill": "#a89878",
    "stroke": "#3a3228"
  },
