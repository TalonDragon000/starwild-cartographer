      "fill": "#2c4a30",
      "stroke": "#101c12"
    },
    {
      "id": "dirt",
      "label": "Dirt",
      "fill": "#8d5e3a",
      "stroke": "#3a2416"
    },
    {
      "id": "sand",
      "label": "Sand",
      "fill": "#e8c85a",
      "stroke": "#5c4310"
    },
    {
      "id": "snow",
      "label": "Snow / ice",
      "fill": "#f4f8fb",
      "stroke": "#3a4e5c"
    },
    {
      "id": "rock",
      "label": "Rock",
      "fill": "#6a6560",
